<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stevedore.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>__NODE__</string>
        <string>__SERVER__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
